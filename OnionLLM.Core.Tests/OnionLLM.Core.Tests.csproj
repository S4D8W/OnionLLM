<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure UI formatting rules (DESIGN.md §5.1–5.2, §8.3), shared with the MAUI app without referencing it. -->
    <Compile Include="..\OnionLLM\ViewModels\Fmt.Format.cs" Link="Ui\Fmt.Format.cs" />
    <Compile Include="..\OnionLLM\ViewModels\FuzzyMatch.cs" Link="Ui\FuzzyMatch.cs" />
    <Compile Include="..\OnionLLM\ViewModels\Alerts.cs" Link="Ui\Alerts.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OnionLLM.Core\OnionLLM.Core.csproj" />
    <ProjectReference Include="..\OnionLLM.Cli\OnionLLM.Cli.csproj" />
  </ItemGroup>

</Project>
