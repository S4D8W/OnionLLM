<?xml version="1.0" encoding="utf-8" ?>
<!-- Control styles (DESIGN.md §4.1, §4.2, §4.4.6). Only token keys — no literals. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== Button (§4.1.1) ===== -->
    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="InterMedium" />
        <Setter Property="FontSize" Value="{DynamicResource TypeLabelSize}" />
        <Setter Property="HeightRequest" Value="{DynamicResource SizeControlHeight}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource SizeMinTarget}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource SizeMinTarget}" />
        <Setter Property="Padding" Value="{StaticResource PaddingButton}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMdInt}" />
        <Setter Property="BorderWidth" Value="{StaticResource Space0}" />
        <Setter Property="BorderColor" Value="{DynamicResource ColorTransparent}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorTransparent}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
    </Style>

    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorActionPrimary}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextOnAction}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorActionPrimaryHover}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorActionPrimaryPressed}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="{StaticResource OpacityDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BorderColor" Value="{DynamicResource ColorBorderFocus}" />
                            <Setter Property="BorderWidth" Value="{StaticResource StrokeFocus}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurface1}" />
        <Setter Property="BorderColor" Value="{DynamicResource ColorBorderDefault}" />
        <Setter Property="BorderWidth" Value="{StaticResource StrokeDefault}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurface2}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurface3}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="{StaticResource OpacityDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BorderColor" Value="{DynamicResource ColorBorderFocus}" />
                            <Setter Property="BorderWidth" Value="{StaticResource StrokeFocus}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextSecondary}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorStateHover}" />
                            <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ColorStatePressed}" />
                            <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="{StaticResource OpacityDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BorderColor" Value="{DynamicResource ColorBorderFocus}" />
                            <Setter Property="BorderWidth" Value="{StaticResource StrokeFocus}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorStatusDanger}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextOnDanger}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="{StaticResource ScalePressed}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="{StaticResource OpacityDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BorderColor" Value="{DynamicResource ColorBorderFocus}" />
                            <Setter Property="BorderWidth" Value="{StaticResource StrokeFocus}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="Button.DangerGhost" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="TextColor" Value="{DynamicResource ColorStatusDanger}" />
    </Style>

    <Style x:Key="Button.Link" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="TextColor" Value="{DynamicResource ColorTextLink}" />
        <Setter Property="Padding" Value="{StaticResource ThicknessZero}" />
        <Setter Property="HeightRequest" Value="{StaticResource SizeMinTarget}" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <!-- Size modifiers (sm / lg) for the most common variants -->
    <Style x:Key="Button.Secondary.Sm" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="HeightRequest" Value="{DynamicResource SizeControlHeightSm}" />
        <Setter Property="Padding" Value="{StaticResource PaddingButtonSm}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmInt}" />
    </Style>
    <Style x:Key="Button.Ghost.Sm" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="HeightRequest" Value="{DynamicResource SizeControlHeightSm}" />
        <Setter Property="Padding" Value="{StaticResource PaddingButtonSm}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmInt}" />
    </Style>
    <Style x:Key="Button.Primary.Lg" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="HeightRequest" Value="{DynamicResource SizeControlHeightLg}" />
        <Setter Property="Padding" Value="{StaticResource PaddingButtonLg}" />
        <Setter Property="FontSize" Value="{DynamicResource TypeBodyStrongSize}" />
    </Style>

    <!-- ===== Fields (§4.2.0–4.2.1) ===== -->
    <Style x:Key="Input.Default" TargetType="Entry">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="{DynamicResource TypeBodySize}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ColorTextTertiary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurface2}" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource SizeControlHeight}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="{StaticResource OpacityDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="Input.Mono" TargetType="Entry" BasedOn="{StaticResource Input.Default}">
        <Setter Property="FontFamily" Value="MonoRegular" />
        <Setter Property="FontSize" Value="{StaticResource TypeMonoSize}" />
    </Style>
    <Style x:Key="Input.Number" TargetType="Entry" BasedOn="{StaticResource Input.Default}">
        <Setter Property="FontFamily" Value="NumMedium" />
        <Setter Property="Keyboard" Value="Numeric" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
    </Style>

    <Style x:Key="Editor.Code" TargetType="Editor">
        <Setter Property="FontFamily" Value="MonoRegular" />
        <Setter Property="FontSize" Value="{StaticResource TypeMonoSize}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource ColorTextTertiary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurface2}" />
        <Setter Property="AutoSize" Value="TextChanges" />
    </Style>

    <!-- Temporary Select (§4.2.3 allows a styled native Picker until the custom control lands). -->
    <Style x:Key="Input.Picker" TargetType="Picker">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="FontSize" Value="{DynamicResource TypeBodySize}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="TitleColor" Value="{DynamicResource ColorTextTertiary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurface2}" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource SizeControlHeight}" />
    </Style>
    <Style x:Key="Input.Date" TargetType="DatePicker">
        <Setter Property="FontFamily" Value="NumMedium" />
        <Setter Property="FontSize" Value="{DynamicResource TypeBodySize}" />
        <Setter Property="TextColor" Value="{DynamicResource ColorTextPrimary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ColorSurface2}" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource SizeControlHeight}" />
    </Style>

    <!-- ===== Toggle, Checkbox, Spinner (§4.2.6, §4.2.7, §4.4.6) ===== -->
    <Style x:Key="Toggle" TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource ColorActionPrimary}" />
        <Setter Property="ThumbColor" Value="{DynamicResource ColorSwitchThumb}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource SizeMinTarget}" />
    </Style>
    <Style x:Key="Checkbox" TargetType="CheckBox">
        <Setter Property="Color" Value="{DynamicResource ColorActionPrimary}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource SizeMinTarget}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource SizeMinTarget}" />
    </Style>
    <Style x:Key="Spinner" TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource ColorActionPrimary}" />
        <Setter Property="WidthRequest" Value="{StaticResource IconSm}" />
        <Setter Property="HeightRequest" Value="{StaticResource IconSm}" />
    </Style>
</ResourceDictionary>
