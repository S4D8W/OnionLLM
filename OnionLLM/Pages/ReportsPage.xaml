<ContentPage x:Class="OnionLLM.Pages.ReportsPage"
             x:Name="Root"
             Shell.NavBarIsVisible="False"
             Title="Raporty"
             BackgroundColor="{AppThemeBinding Light=#F2F4F8, Dark=#0C0E13}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="16,14,16,10" RowSpacing="10">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <Button Text="☰" Clicked="OnMenuClicked" FontSize="20" Padding="0" WidthRequest="42" HeightRequest="42" CornerRadius="13"
                    BackgroundColor="{AppThemeBinding Light=#E6E9F1, Dark=#252832}" TextColor="{AppThemeBinding Light=#313541, Dark=White}"
                    SemanticProperties.Description="Otwórz nawigację" />
            <Label Grid.Column="1" Text="Raporty" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="JSON" Command="{Binding ExportJsonCommand}" FontSize="11" Padding="10,0" HeightRequest="32" CornerRadius="10"
                    BackgroundColor="{AppThemeBinding Light=#E6E9F1, Dark=#252832}" TextColor="{AppThemeBinding Light=#313541, Dark=White}" />
            <Button Grid.Column="3" Text="CSV" Command="{Binding ExportCsvCommand}" FontSize="11" Padding="10,0" HeightRequest="32" CornerRadius="10"
                    BackgroundColor="{AppThemeBinding Light=#E6E9F1, Dark=#252832}" TextColor="{AppThemeBinding Light=#313541, Dark=White}" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="6">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Picker ItemsSource="{Binding Periods}" SelectedIndex="{Binding PeriodIndex}" FontSize="12" Title="Okres" />
                <Picker Grid.Column="1" ItemsSource="{Binding Ranges}" SelectedIndex="{Binding RangeIndex}" FontSize="12" Title="Zakres" />
                <Picker Grid.Column="2" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" FontSize="12" Title="Źródło" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6" IsVisible="{Binding IsCustomRange}">
                <Label Text="od" FontSize="11" VerticalOptions="Center" />
                <DatePicker Grid.Column="1" Date="{Binding Since}" FontSize="12" Format="yyyy-MM-dd" />
                <Label Grid.Column="2" Text="do" FontSize="11" VerticalOptions="Center" />
                <DatePicker Grid.Column="3" Date="{Binding Until}" FontSize="12" Format="yyyy-MM-dd" />
            </Grid>
            <HorizontalStackLayout Spacing="14">
                <HorizontalStackLayout Spacing="4">
                    <CheckBox IsChecked="{Binding Breakdown}" />
                    <Label Text="podział na modele" FontSize="11" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="4" IsVisible="{Binding CanSplitBySource}">
                    <CheckBox IsChecked="{Binding BySource}" />
                    <Label Text="podział na źródła" FontSize="11" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="4">
                    <CheckBox IsChecked="{Binding GroupByProject}" />
                    <Label Text="grupuj po projekcie" FontSize="11" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <Border Grid.Row="2" Padding="14,12" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#151821}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="1">
                        <Label Text="RAZEM" FontSize="9" FontAttributes="Bold" CharacterSpacing="1" TextColor="{AppThemeBinding Light=#6861A4, Dark=#9D97DA}" />
                        <Label Text="{Binding TotalDetails}" FontSize="10" TextColor="{AppThemeBinding Light=#858B98, Dark=#8E94A2}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                        <Label Text="{Binding TotalCost}" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="End" />
                        <Label Text="{Binding TotalTokens}" FontSize="10" HorizontalTextAlignment="End" TextColor="{AppThemeBinding Light=#858B98, Dark=#8E94A2}" />
                    </VerticalStackLayout>
                </Grid>
                <GraphicsView x:Name="ChartView" HeightRequest="110" />
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="3" ItemsSource="{Binding Rows}" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12,10" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E5EC, Dark=#282C37}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#151821}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="13" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BindingContext.ShowDetailsCommand, Source={x:Reference Root}}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="3">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <Label Text="{Binding Period}" FontSize="13" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding Tokens}" FontSize="12" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#858B98, Dark=#8E94A2}" />
                                <Label Grid.Column="2" Text="{Binding Cost}" FontSize="13" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#4F3FD5, Dark=#A99FFF}" />
                            </Grid>
                            <Label Text="{Binding Subtitle}" FontSize="10" LineBreakMode="TailTruncation" TextColor="{AppThemeBinding Light=#727986, Dark=#9BA0AD}" />
                            <Label Text="{Binding Details}" FontSize="9" TextColor="{AppThemeBinding Light=#8B909C, Dark=#707582}" />
                            <Label Text="{Binding Breakdown}" IsVisible="{Binding HasBreakdown}" FontSize="9" FontFamily="Consolas"
                                   TextColor="{AppThemeBinding Light=#727986, Dark=#9BA0AD}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="4" Spacing="2">
            <Label Text="{Binding PricingNote}" IsVisible="{Binding HasPricingNote}" FontSize="9" LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light=#B26B00, Dark=#F5A524}" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#6C5CE7" WidthRequest="14" HeightRequest="14" />
                <Label Grid.Column="1" Text="{Binding Status}" FontSize="9" LineBreakMode="TailTruncation" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#8B909C, Dark=#707582}" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
