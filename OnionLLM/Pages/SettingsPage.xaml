<ContentPage x:Class="OnionLLM.Pages.SettingsPage"
             Shell.NavBarIsVisible="False"
             Title="Ustawienia"
             BackgroundColor="{AppThemeBinding Light=#F2F4F8, Dark=#0C0E13}">

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,16" Spacing="12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Text="☰" Clicked="OnMenuClicked" FontSize="20" Padding="0" WidthRequest="42" HeightRequest="42" CornerRadius="13"
                        BackgroundColor="{AppThemeBinding Light=#E6E9F1, Dark=#252832}" TextColor="{AppThemeBinding Light=#313541, Dark=White}"
                        SemanticProperties.Description="Otwórz nawigację" />
                <Label Grid.Column="1" Text="Ustawienia" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
            </Grid>

            <Border Padding="14,12" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#151821}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                    <Label Text="Strefa czasowa" FontSize="12" VerticalOptions="Center" />
                    <Entry Grid.Column="1" Text="{Binding Timezone}" Placeholder="systemowa (np. Europe/Warsaw, UTC)" FontSize="12" />

                    <Label Grid.Row="1" Text="Tryb kosztu" FontSize="12" VerticalOptions="Center" />
                    <Picker Grid.Row="1" Grid.Column="1" ItemsSource="{Binding CostModes}" SelectedIndex="{Binding CostModeIndex}" FontSize="12" />

                    <Label Grid.Row="2" Text="Cennik offline" FontSize="12" VerticalOptions="Center" />
                    <Switch Grid.Row="2" Grid.Column="1" IsToggled="{Binding Offline}" HorizontalOptions="Start" />

                    <Label Grid.Row="3" Text="Początek tygodnia" FontSize="12" VerticalOptions="Center" />
                    <Picker Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Days}" SelectedIndex="{Binding StartOfWeekIndex}" FontSize="12" />

                    <Label Grid.Row="4" Text="Długość bloku (h)" FontSize="12" VerticalOptions="Center" />
                    <Entry Grid.Row="4" Grid.Column="1" Text="{Binding SessionLength}" Keyboard="Numeric" FontSize="12" />

                    <Label Grid.Row="5" Text="Limit tokenów bloku" FontSize="12" VerticalOptions="Center" />
                    <Entry Grid.Row="5" Grid.Column="1" Text="{Binding TokenLimit}" Placeholder="max lub liczba" FontSize="12" />

                    <Label Grid.Row="6" Text="Odświeżanie (s)" FontSize="12" VerticalOptions="Center" />
                    <Entry Grid.Row="6" Grid.Column="1" Text="{Binding RefreshInterval}" Keyboard="Numeric" FontSize="12" />

                    <Label Grid.Row="7" Text="Sesja aktywna (min)" FontSize="12" VerticalOptions="Center" />
                    <Entry Grid.Row="7" Grid.Column="1" Text="{Binding ActiveMinutes}" Keyboard="Numeric" FontSize="12" />

                    <Label Grid.Row="8" Text="Aliasy projektów" FontSize="12" VerticalOptions="Center" />
                    <Entry Grid.Row="8" Grid.Column="1" Text="{Binding ProjectAliases}" Placeholder="klucz=Nazwa,klucz2=Nazwa2" FontSize="12" />
                </Grid>
            </Border>

            <Label Text="ŹRÓDŁA DANYCH" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" TextColor="{AppThemeBinding Light=#6861A4, Dark=#9D97DA}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sources}" Spacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12,8" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#151821}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold" />
                                        <Label Text="{Binding State}" FontSize="9" LineBreakMode="TailTruncation" TextColor="{AppThemeBinding Light=#858B98, Dark=#8E94A2}" />
                                    </VerticalStackLayout>
                                    <Switch Grid.Column="1" IsToggled="{Binding Enabled}" />
                                </Grid>
                                <Entry Text="{Binding Paths}" Placeholder="własne katalogi (oddzielone ;) — puste = domyślne/zmienne środowiskowe" FontSize="11" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding IsCodex}">
                                    <Label Text="Poziom szybkości do wyceny" FontSize="11" VerticalOptions="Center" />
                                    <Picker Grid.Column="1" ItemsSource="{Binding Speeds}" SelectedIndex="{Binding SpeedIndex}" FontSize="11" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsOpenCode}">
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="Licz tury claude-agent" FontSize="11" />
                                        <Label Text="zwykle liczy je już Claude Code — włącz tylko bez tego źródła" FontSize="9"
                                               TextColor="{AppThemeBinding Light=#858B98, Dark=#8E94A2}" />
                                    </VerticalStackLayout>
                                    <Switch Grid.Column="1" IsToggled="{Binding IncludeClaudeAgent}" />
                                </Grid>
                                <VerticalStackLayout Spacing="3" IsVisible="{Binding IsPi}">
                                    <Entry Text="{Binding AgentDirs}" Placeholder="katalogi agenta pi (czytany &lt;katalog&gt;\sessions; oddzielone ;)" FontSize="11" />
                                    <Entry Text="{Binding Stores}" Placeholder="magazyny sesji: nazwa=ścieżka; nazwa2=ścieżka2" FontSize="11" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="CENNIK" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" TextColor="{AppThemeBinding Light=#6861A4, Dark=#9D97DA}" />
            <Border Padding="14,12" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#151821}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                        <Label Text="LiteLLM" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding LiteLlmStatus}" FontSize="11" VerticalOptions="Center" />
                        <Label Grid.Row="1" Text="models.dev" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding ModelsDevStatus}" FontSize="11" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="LiteLLM to cennik główny; models.dev wycenia modele, których LiteLLM nie zna. Przycisk Odśwież cennik pobiera oba źródła (w trybie offline używany jest cache lub snapshot w aplikacji)."
                           FontSize="9" TextColor="{AppThemeBinding Light=#858B98, Dark=#8E94A2}" />

                    <Label Text="Aliasy modeli (wycena)" FontSize="12" Margin="0,6,0,0" />
                    <Label Text="Jeden wpis w wierszu: nazwa z logu=model w cenniku (np. private-alpha=gpt-5.5). Nazwa z sufiksem -fast korzysta z aliasu nazwy bazowej; nazwa wyświetlana się nie zmienia."
                           FontSize="9" TextColor="{AppThemeBinding Light=#858B98, Dark=#8E94A2}" />
                    <Editor Text="{Binding ModelAliases}" Placeholder="nazwa-z-logu=model-w-cenniku" FontSize="11" FontFamily="Consolas" HeightRequest="84" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                    <Label Text="NADPISANIA CEN" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" TextColor="{AppThemeBinding Light=#6861A4, Dark=#9D97DA}" />
                    <Label Text="USD za 1M tokenów; puste pole = stawka z cennika. Klucz: model, dostawca/model lub [źródło] model."
                           FontSize="9" TextColor="{AppThemeBinding Light=#858B98, Dark=#8E94A2}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Dodaj" Command="{Binding AddOverrideCommand}" FontSize="10" Padding="10,0" HeightRequest="28" CornerRadius="8"
                        BackgroundColor="{AppThemeBinding Light=#E6E9F1, Dark=#252832}" TextColor="{AppThemeBinding Light=#313541, Dark=White}" />
            </Grid>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding PricingOverrides}" Spacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12,8" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#151821}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                    <Entry Text="{Binding Key}" Placeholder="model, dostawca/model lub [źródło] model" FontSize="11" />
                                    <Label Grid.Column="1" Text="Zaawansowane" FontSize="10" VerticalOptions="Center" />
                                    <Switch Grid.Column="2" IsToggled="{Binding ShowAdvanced}" VerticalOptions="Center" />
                                    <Button Grid.Column="3" Text="Usuń" Command="{Binding RemoveCommand}" FontSize="10" Padding="8,0" HeightRequest="28" CornerRadius="8" VerticalOptions="Center"
                                            BackgroundColor="{AppThemeBinding Light=#E6E9F1, Dark=#252832}" TextColor="{AppThemeBinding Light=#313541, Dark=White}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="1">
                                    <Label Text="Wejście" FontSize="9" TextColor="{AppThemeBinding Light=#858B98, Dark=#8E94A2}" />
                                    <Label Grid.Column="1" Text="Wyjście" FontSize="9" TextColor="{AppThemeBinding Light=#858B98, Dark=#8E94A2}" />
                                    <Label Grid.Column="2" Text="Zapis cache (5 min)" FontSize="9" TextColor="{AppThemeBinding Light=#858B98, Dark=#8E94A2}" />
                                    <Label Grid.Column="3" Text="Zapis cache 1 h" FontSize="9" TextColor="{AppThemeBinding Light=#858B98, Dark=#8E94A2}" />
                                    <Label Grid.Column="4" Text="Odczyt cache" FontSize="9" TextColor="{AppThemeBinding Light=#858B98, Dark=#8E94A2}" />
                                    <Entry Grid.Row="1" Text="{Binding Input}" Keyboard="Numeric" FontSize="11" />
                                    <Entry Grid.Row="1" Grid.Column="1" Text="{Binding Output}" Keyboard="Numeric" FontSize="11" />
                                    <Entry Grid.Row="1" Grid.Column="2" Text="{Binding CacheWrite}" Keyboard="Numeric" FontSize="11" />
                                    <Entry Grid.Row="1" Grid.Column="3" Text="{Binding CacheWrite1h}" Keyboard="Numeric" FontSize="11" />
                                    <Entry Grid.Row="1" Grid.Column="4" Text="{Binding CacheRead}" Keyboard="Numeric" FontSize="11" />
                                </Grid>
                                <VerticalStackLayout Spacing="4" IsVisible="{Binding ShowAdvanced}">
                                    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="1">
                                        <Label Text="Wejście &gt;200k" FontSize="9" TextColor="{AppThemeBinding Light=#858B98, Dark=#8E94A2}" />
                                        <Label Grid.Column="1" Text="Wyjście &gt;200k" FontSize="9" TextColor="{AppThemeBinding Light=#858B98, Dark=#8E94A2}" />
                                        <Label Grid.Column="2" Text="Zapis cache &gt;200k" FontSize="9" TextColor="{AppThemeBinding Light=#858B98, Dark=#8E94A2}" />
                                        <Label Grid.Column="3" Text="Odczyt cache &gt;200k" FontSize="9" TextColor="{AppThemeBinding Light=#858B98, Dark=#8E94A2}" />
                                        <Entry Grid.Row="1" Text="{Binding InputAbove200k}" Keyboard="Numeric" FontSize="11" />
                                        <Entry Grid.Row="1" Grid.Column="1" Text="{Binding OutputAbove200k}" Keyboard="Numeric" FontSize="11" />
                                        <Entry Grid.Row="1" Grid.Column="2" Text="{Binding CacheWriteAbove200k}" Keyboard="Numeric" FontSize="11" />
                                        <Entry Grid.Row="1" Grid.Column="3" Text="{Binding CacheReadAbove200k}" Keyboard="Numeric" FontSize="11" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="1">
                                        <Label Text="Maks. tokenów wejścia (próg)" FontSize="9" TextColor="{AppThemeBinding Light=#858B98, Dark=#8E94A2}" />
                                        <Label Grid.Column="1" Text="Mnożnik fast" FontSize="9" TextColor="{AppThemeBinding Light=#858B98, Dark=#8E94A2}" />
                                        <Label Grid.Column="2" Text="Mnożnik flex" FontSize="9" TextColor="{AppThemeBinding Light=#858B98, Dark=#8E94A2}" />
                                        <Entry Grid.Row="1" Text="{Binding MaxInputTokens}" Keyboard="Numeric" Placeholder="np. 1000000" FontSize="11" />
                                        <Entry Grid.Row="1" Grid.Column="1" Text="{Binding FastMultiplier}" Keyboard="Numeric" Placeholder="np. 6" FontSize="11" />
                                        <Entry Grid.Row="1" Grid.Column="2" Text="{Binding FlexMultiplier}" Keyboard="Numeric" Placeholder="np. 0.5" FontSize="11" />
                                    </Grid>
                                    <Label Text="Stawki &gt;200k obowiązują powyżej progu długiego kontekstu (z cennika lub 200k). Mnożniki: krotność ceny w trybie fast/flex."
                                           FontSize="9" TextColor="{AppThemeBinding Light=#858B98, Dark=#8E94A2}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="STATUSLINE" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" TextColor="{AppThemeBinding Light=#6861A4, Dark=#9D97DA}" />
            <Border Padding="14,12" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#151821}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Etykiety modeli" FontSize="12" />
                    <Label Text="Jeden wpis w wierszu: dokładna nazwa modelu z Claude Code=krótka etykieta (np. ARN profilu Bedrock=claude-opus-4-6)."
                           FontSize="9" TextColor="{AppThemeBinding Light=#858B98, Dark=#8E94A2}" />
                    <Editor Text="{Binding ModelLabelAliases}" Placeholder="nazwa-modelu=etykieta" FontSize="11" FontFamily="Consolas" HeightRequest="84" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Text="Zapisz" Command="{Binding SaveCommand}" FontSize="12" CornerRadius="10" BackgroundColor="#5B4BFF" TextColor="White" />
                <Button Grid.Column="1" Text="Odśwież cennik" Command="{Binding RefreshPricingCommand}" FontSize="12" CornerRadius="10"
                        BackgroundColor="{AppThemeBinding Light=#E6E9F1, Dark=#252832}" TextColor="{AppThemeBinding Light=#313541, Dark=White}" />
                <Button Grid.Column="2" Text="Przebuduj bazę" Command="{Binding RebuildCommand}" FontSize="12" CornerRadius="10"
                        BackgroundColor="{AppThemeBinding Light=#E6E9F1, Dark=#252832}" TextColor="{AppThemeBinding Light=#313541, Dark=White}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#6C5CE7" WidthRequest="14" HeightRequest="14" />
                <Label Grid.Column="1" Text="{Binding Status}" FontSize="10" />
            </Grid>
            <Label FontSize="9" TextColor="{AppThemeBinding Light=#8B909C, Dark=#707582}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Plik konfiguracji: " />
                        <Span Text="{Binding ConfigPath}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="DIAGNOSTYKA" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#6861A4, Dark=#9D97DA}" />
                <Button Grid.Column="1" Text="Folder danych" Command="{Binding OpenFolderCommand}" FontSize="10" Padding="8,0" HeightRequest="28" CornerRadius="8"
                        BackgroundColor="{AppThemeBinding Light=#E6E9F1, Dark=#252832}" TextColor="{AppThemeBinding Light=#313541, Dark=White}" />
            </Grid>
            <Border Padding="12,10" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#151821}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label Text="{Binding Diagnostics}" FontSize="9" FontFamily="Consolas" />
            </Border>

            <Label Text="ROZBIEŻNOŚCI KOSZTU" FontSize="10" FontAttributes="Bold" CharacterSpacing="1"
                   TextColor="{AppThemeBinding Light=#6861A4, Dark=#9D97DA}" />
            <Label Text="Porównanie kosztu zapisanego przez narzędzie (np. costUSD Claude Code) z wyliczonym z cennika, z przykładami największych różnic."
                   FontSize="9" TextColor="{AppThemeBinding Light=#858B98, Dark=#8E94A2}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Picker ItemsSource="{Binding MismatchRanges}" SelectedIndex="{Binding MismatchRangeIndex}" FontSize="12" Title="Zakres" />
                <Button Grid.Column="1" Text="Sprawdź" Command="{Binding CheckMismatchesCommand}" FontSize="11" Padding="12,0" HeightRequest="32" CornerRadius="10"
                        BackgroundColor="{AppThemeBinding Light=#E6E9F1, Dark=#252832}" TextColor="{AppThemeBinding Light=#313541, Dark=White}" />
            </Grid>
            <Border Padding="12,10" StrokeThickness="0" IsVisible="{Binding HasPricingMismatches}" BackgroundColor="{AppThemeBinding Light=White, Dark=#151821}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label Text="{Binding PricingMismatches}" FontSize="9" FontFamily="Consolas" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
