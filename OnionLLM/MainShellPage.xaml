<?xml version="1.0" encoding="utf-8" ?>
<!--
    Main window structure (DESIGN.md §2.9.3): Sidebar | content (screen view with its PageHeader · StatusBar).
    Overlay layers on top: sidebar overlay (medium/narrow), toasts, dialog. The drawer column arrives with §4.6.1.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:OnionLLM.Controls"
             xmlns:nav="clr-namespace:OnionLLM.Navigation"
             x:Class="OnionLLM.MainShellPage"
             x:DataType="nav:ShellViewModel"
             Title="OnionLLM">
    <Grid x:Name="Root">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{Binding DrawerColumn}" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
                <!-- S-IMPORT (§6.0): history import continued in the background. -->
                <controls:Banner Kind="Info" Title="Import historii w toku" Message="{Binding ImportBannerText}"
                                 IsVisible="{Binding IsImportBannerVisible}" Margin="{DynamicResource LayoutPagePadding}"
                                 AutomationId="Shell.ImportBanner" />
                <ContentView x:Name="Presenter" Grid.Row="1" />
                <controls:StatusBar Grid.Row="2" />
            </Grid>

            <!-- Click outside the sidebar overlay closes it (no scrim, §4.7.1). -->
            <Grid Grid.Column="1"
                  BackgroundColor="{DynamicResource ColorTransparent}"
                  IsVisible="{Binding IsOverlayOpen}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseOverlayCommand}" />
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Drawer (DESIGN.md 4.6.1): third column on wide windows, overlay with scrim otherwise. -->
            <Grid Grid.Column="1" Grid.ColumnSpan="2"
                  BackgroundColor="{DynamicResource ColorScrim}"
                  IsVisible="{Binding IsDrawerScrimVisible}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseDrawerCommand}" />
                </Grid.GestureRecognizers>
            </Grid>
            <controls:Drawer Grid.Column="1" Grid.ColumnSpan="2" />

            <controls:Sidebar x:Name="SidebarView"
                              Grid.ColumnSpan="{Binding SidebarColumnSpan}"
                              HorizontalOptions="Start"
                              ZIndex="10" />
        </Grid>

        <controls:PopoverHost />
        <controls:ToastHost Padding="{StaticResource PaddingToastHost}" />
        <controls:CommandPalette />
        <controls:DialogHost />
    </Grid>
</ContentPage>
