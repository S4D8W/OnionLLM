<?xml version="1.0" encoding="utf-8" ?>
<!-- Sesje (DESIGN.md §6.4): PageHeader (total, Eksportuj) → FilterBar → DataTable (paging, drawer) → PricingNote. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:OnionLLM.Controls"
             xmlns:vm="clr-namespace:OnionLLM.ViewModels"
             xmlns:res="clr-namespace:OnionLLM.Resources"
             x:Class="OnionLLM.Views.SessionsView"
             x:DataType="vm:SessionsViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="{DynamicResource LayoutPagePadding}"
          RowSpacing="{StaticResource Space300}">
        <controls:PageHeader Title="Sesje" Subtitle="{Binding Total}">
            <controls:SplitButton x:Name="ExportButton" Text="Eksportuj" Command="{Binding ExportCsvCommand}" AutomationId="Sessions.Export" />
        </controls:PageHeader>

        <controls:FilterBar Grid.Row="1" IsDirty="{Binding IsFiltered}" ResetCommand="{Binding ResetFiltersCommand}">
            <controls:DateRangePicker Presets="{Binding Presets}" PresetIndex="{Binding RangeIndex}" CustomIndex="{Binding CustomPresetIndex}"
                                      Since="{Binding Since}" Until="{Binding Until}" DisplayText="{Binding RangeText}" AutomationId="Sessions.Range" />
            <controls:FilterChip Variant="Menu" Label="Źródło" ItemsSource="{Binding SourceChoiceNames}" SelectedIndex="{Binding SourceIndex}" AutomationId="Sessions.Source" />
            <controls:FilterChip Variant="Removable" Label="{Binding ProjectFilterText}" IsVisible="{Binding HasProjectFilter}"
                                 RemoveCommand="{Binding ClearProjectCommand}" AutomationId="Sessions.ProjectFilter" />
            <controls:SearchField x:Name="SearchBox" Placeholder="Szukaj: ID sesji, projekt, model, źródło" Query="{Binding Search}"
                                  MinimumWidthRequest="{StaticResource SizeDrawerMin}" AutomationId="Sessions.Search" />
        </controls:FilterBar>

        <controls:DataTable x:Name="Table" Grid.Row="2"
                            ItemsSource="{Binding Sessions}"
                            SortKey="{Binding SortKey}"
                            SortDescending="{Binding SortDescending}"
                            SelectedItem="{Binding SelectedSession}"
                            RowActivatedCommand="{Binding OpenDetailsCommand}"
                            State="{Binding TableState}"
                            FooterText="{Binding FooterText}"
                            CanShowMore="{Binding CanShowMore}"
                            ShowMoreCommand="{Binding ShowMoreCommand}"
                            AutomationPrefix="Sessions">
            <controls:DataTable.EmptyView>
                <controls:EmptyState Variant="Inline" Glyph="{x:Static res:Icons.SquareTerminal}"
                                     Title="{Binding EmptyTitle}" ActionText="{Binding EmptyAction}" ActionCommand="{Binding EmptyCommand}" />
            </controls:DataTable.EmptyView>
        </controls:DataTable>

        <controls:PricingNote Grid.Row="3" Text="{Binding PricingNote}" />
    </Grid>
</ContentView>
