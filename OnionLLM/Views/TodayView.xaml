<?xml version="1.0" encoding="utf-8" ?>
<!--
    Dziś (DESIGN.md §6.1): PageHeader → Banner → hero (cost of the day + OnionRings) → KPI row → active Claude block →
    „Źródła dziś”. Placement per breakpoint is done in code-behind (ApplyLayout).
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:OnionLLM.Controls"
             xmlns:charts="clr-namespace:OnionLLM.Controls.Charts"
             xmlns:vm="clr-namespace:OnionLLM.ViewModels"
             xmlns:res="clr-namespace:OnionLLM.Resources"
             x:Class="OnionLLM.Views.TodayView"
             x:DataType="vm:MainViewModel">
    <Grid RowDefinitions="Auto,Auto,*"
          Padding="{DynamicResource LayoutPagePadding}"
          RowSpacing="{StaticResource Space300}">
        <controls:PageHeader Title="Dziś" Subtitle="{Binding DateSubtitle}" />

        <controls:Banner Grid.Row="1"
                         IsVisible="{Binding HasBanner}"
                         Kind="{Binding BannerKind}"
                         Title="{Binding BannerTitle}"
                         Message="{Binding BannerMessage}"
                         CanClose="True"
                         CloseCommand="{Binding CloseBannerCommand}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="{DynamicResource LayoutSectionGap}">
                <Grid x:Name="TopGrid" ColumnSpacing="{DynamicResource LayoutGridGap}" RowSpacing="{DynamicResource LayoutGridGap}">
                    <!-- Hero (§4.3.3) -->
                    <Border x:Name="HeroCard" Style="{StaticResource Card.Hero}" AutomationId="Today.Hero">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHeroTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space600}">
                            <controls:HeroMetric Value="{Binding TodayCost}"
                                                 Marker="{Binding TodayMarker}"
                                                 Caption="{Binding TodayCaption}"
                                                 IsStale="{Binding IsStale}"
                                                 VerticalOptions="Center" />
                            <HorizontalStackLayout x:Name="HeroRings" Grid.Column="1" Spacing="{StaticResource Space400}"
                                                   IsVisible="{Binding HasLimitRings}">
                                <charts:OnionRings OnHero="True"
                                                   Rings="{Binding LimitRings}"
                                                   WidthRequest="{DynamicResource SizeRingHero}"
                                                   HeightRequest="{DynamicResource SizeRingHero}"
                                                   AutomationId="Today.Rings">
                                    <charts:OnionRings.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRingsTapped" />
                                    </charts:OnionRings.GestureRecognizers>
                                </charts:OnionRings>
                                <charts:RingLegend OnHero="True" Rings="{Binding LimitRings}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>

                    <!-- „Limity” card when the rings do not fit in the hero (medium/narrow) -->
                    <controls:Card x:Name="LimitsCard" Title="Limity" IsVisible="False">
                        <controls:Card.Body>
                            <VerticalStackLayout Spacing="{StaticResource Space300}">
                                <HorizontalStackLayout Spacing="{StaticResource Space400}">
                                    <charts:OnionRings Rings="{Binding LimitRings}"
                                                       WidthRequest="{StaticResource SizeRingCard}"
                                                       HeightRequest="{StaticResource SizeRingCard}" />
                                    <charts:RingLegend Rings="{Binding LimitRings}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </controls:Card.Body>
                    </controls:Card>

                    <!-- Active Claude block (§6.1 pkt 5) -->
                    <controls:Card x:Name="BlockCard"
                                   Title="Aktywny blok Claude"
                                   Variant="Interactive"
                                   IsVisible="{Binding HasActiveBlock}"
                                   AutomationId="Today.ActiveBlock">
                        <controls:Card.Actions>
                            <controls:StatusBadge Text="Aktywny" Kind="Live" />
                        </controls:Card.Actions>
                        <controls:Card.Body>
                            <VerticalStackLayout Spacing="{StaticResource Space300}">
                                <Label Style="{StaticResource Text.Caption.Secondary}" Text="{Binding BlockRemaining}" />
                                <charts:BlockTimeline Cumulative="{Binding BlockSeries}"
                                                      Now="{Binding BlockNow}"
                                                      Projection="{Binding BlockProjection}" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space400}">
                                    <controls:MetricLabel Value="{Binding BlockCost}" Size="Md" Format="Cost" TextColor="{DynamicResource ColorDataCost}" />
                                    <Label Grid.Column="1" Style="{StaticResource Text.Caption}" Text="{Binding BlockTokens}" VerticalOptions="End" />
                                </Grid>
                                <controls:BurnRateBadge IsVisible="{Binding HasBurnRate}"
                                                        CostPerHour="{Binding BurnCostPerHour}"
                                                        TokensPerMinute="{Binding BurnTokensPerMinute}"
                                                        Level="{Binding BurnLevel}" />
                                <Label Style="{StaticResource Text.Caption}" Text="{Binding BlockProjectionText}" />
                                <controls:LimitGauge IsVisible="{Binding HasBlockLimit}"
                                                     Title="{Binding BlockLimitTitle}"
                                                     Percent="{Binding BlockLimitPercent}"
                                                     State="Estimated" />
                            </VerticalStackLayout>
                        </controls:Card.Body>
                    </controls:Card>
                </Grid>

                <!-- KPI row (§6.1 pkt 4) -->
                <Grid x:Name="KpiGrid" ColumnSpacing="{DynamicResource LayoutGridGap}" RowSpacing="{DynamicResource LayoutGridGap}">
                    <controls:StatTile x:Name="WeekTile" Title="7 dni" Value="{Binding WeekCost}" Caption="{Binding WeekTokens}"
                                       IsLoading="{Binding IsLoading}" Variant="Interactive" AutomationId="Today.Kpi.Week" />
                    <controls:StatTile x:Name="MonthTile" Title="30 dni" Value="{Binding MonthCost}" Caption="{Binding MonthTokens}"
                                       IsLoading="{Binding IsLoading}" Variant="Interactive" AutomationId="Today.Kpi.Month" />
                    <controls:StatTile x:Name="TokensTile" Title="Tokeny dziś" Value="{Binding TodayTokens}"
                                       IsLoading="{Binding IsLoading}" AutomationId="Today.Kpi.Tokens" />
                    <controls:StatTile x:Name="SessionsTile" Title="Sesje" Value="{Binding SessionsValue}" Caption="{Binding SessionsCaption}"
                                       IsLoading="{Binding IsLoading}" Variant="Interactive" AutomationId="Today.Kpi.Sessions" />
                </Grid>

                <!-- „Źródła dziś” (§6.1 pkt 6) -->
                <controls:Section Title="Źródła dziś" Description="Kolejność zmienisz przeciąganiem kart lub z menu karty">
                    <controls:Section.Actions>
                        <HorizontalStackLayout Spacing="{StaticResource Space200}">
                            <Button Style="{StaticResource Button.Link}" Text="{Binding UndetectedToggleText}"
                                    Command="{Binding ToggleUndetectedCommand}" AutomationId="Today.ToggleUndetected" />
                            <controls:IconButton x:Name="SourcesMenu" Style="{StaticResource IconButton.Ghost.Sm}" Glyph="{x:Static res:Icons.Ellipsis}"
                                                 ToolTipProperties.Text="Więcej" SemanticProperties.Description="Więcej opcji źródeł"
                                                 Clicked="OnSourcesMenu" AutomationId="Today.SourcesMenu" />
                        </HorizontalStackLayout>
                    </controls:Section.Actions>
                    <controls:Section.Body>
                        <FlexLayout x:Name="SourcesFlex" Wrap="Wrap" AlignItems="Start" />
                    </controls:Section.Body>
                </controls:Section>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>
