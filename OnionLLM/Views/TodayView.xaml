<?xml version="1.0" encoding="utf-8" ?>
<!-- Dziś (DESIGN.md §6.1). Content still awaits the 12.3 rebuild (KPI row, OnionRings, SourceCard, BlockTimeline). -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:OnionLLM.Controls"
             x:Class="OnionLLM.Views.TodayView">
    <Grid RowDefinitions="Auto,*"
          Padding="{DynamicResource LayoutPagePadding}"
          RowSpacing="{StaticResource Space300}">
        <controls:PageHeader Title="Dziś" Subtitle="{Binding DateSubtitle}" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Providers}"
                        SelectionMode="None"
                        CanReorderItems="True"
                        ReorderCompleted="OnProvidersReordered"
                        VerticalScrollBarVisibility="Never">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout Spacing="10" Padding="0,0,0,10">
                    <!-- Podsumowanie dnia -->
                    <Border Padding="22,19" StrokeThickness="1" Stroke="#33FFFFFF">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#26000000" Offset="0,4" Radius="14" Opacity="0.34" />
                        </Border.Shadow>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#24213D" Offset="0" />
                                <GradientStop Color="#5146C7" Offset="0.58" />
                                <GradientStop Color="#6B61E8" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="22">
                            <VerticalStackLayout Spacing="4">
                                <HorizontalStackLayout Spacing="7">
                                    <Border WidthRequest="6" HeightRequest="6" BackgroundColor="#78E6A3" StrokeThickness="0" VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="3" />
                                        </Border.StrokeShape>
                                    </Border>
                                    <Label Text="DZIŚ" FontFamily="Segoe UI Variable" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.2" TextColor="#E3E0FF" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding TodayCost}" FontFamily="Segoe UI Variable" FontSize="36" FontAttributes="Bold" TextColor="White" />
                                <Label FontFamily="Segoe UI Variable" FontSize="12" TextColor="#D8D5F2">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding TodayTokens}" FontAttributes="Bold" />
                                            <Span Text=" tokenów w sumie" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End" Spacing="4">
                                <Label Text="{Binding ActiveProviders}" FontFamily="Segoe UI Variable" FontSize="14" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="End" />
                                <Label Text="{Binding WeekSummary}" FontFamily="Segoe UI Variable" FontSize="11" TextColor="#D8D5F2" HorizontalTextAlignment="End" />
                                <Label Text="{Binding MonthSummary}" FontFamily="Segoe UI Variable" FontSize="11" TextColor="#D8D5F2" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Aktywny blok 5h Claude -->
                    <Border IsVisible="{Binding HasActiveBlock}"
                            Padding="17,14"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E0E2E7, Dark=#303239}"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B1D22}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#14000000" Offset="0,2" Radius="8" Opacity="0.3" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="9">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="AKTYWNY BLOK CLAUDE" FontFamily="Segoe UI Variable" FontSize="9" FontAttributes="Bold" CharacterSpacing="0.9"
                                           TextColor="{AppThemeBinding Light=#665E9C, Dark=#AAA3E4}" />
                                    <Label FontFamily="Segoe UI Variable" FontSize="16" FontAttributes="Bold">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Pozostało " />
                                                <Span Text="{Binding BlockRemaining}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Text="{Binding BlockEnds}" FontFamily="Segoe UI Variable" FontSize="11" TextColor="{AppThemeBinding Light=#747A85, Dark=#9A9FAB}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                    <Label Text="{Binding BlockCost}" FontFamily="Segoe UI Variable" FontSize="21" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                    <Label Text="{Binding BlockTokens}" FontFamily="Segoe UI Variable" FontSize="11" HorizontalTextAlignment="End"
                                           TextColor="{AppThemeBinding Light=#747A85, Dark=#9A9FAB}" />
                                </VerticalStackLayout>
                            </Grid>
                            <ProgressBar Progress="{Binding BlockLimitProgress}" ProgressColor="#D97757" HeightRequest="4"
                                         BackgroundColor="{AppThemeBinding Light=#ECEEF2, Dark=#2B2D34}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding BlockLimitDisplay}" FontFamily="Segoe UI Variable" FontSize="10" TextColor="{AppThemeBinding Light=#7A7E94, Dark=#9296AA}" />
                                <Label Grid.Column="1" Text="{Binding Projection}" FontFamily="Segoe UI Variable" FontSize="10" TextColor="{AppThemeBinding Light=#7A7E94, Dark=#9296AA}" />
                            </Grid>
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="" FontFamily="Segoe MDL2 Assets" FontSize="11" TextColor="#D97757" VerticalOptions="Center" />
                                <Label Text="{Binding BurnRate}" FontFamily="Segoe UI Variable" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Text="{Binding BurnLevel}" FontFamily="Segoe UI Variable" FontSize="10" TextColor="{Binding BurnColor}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="0"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E0E2E7, Dark=#303239}"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B1D22}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#12000000" Offset="0,2" Radius="8" Opacity="0.28" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="3,*">
                            <BoxView Color="{Binding AccentColor}" />
                            <VerticalStackLayout Grid.Column="1" Padding="17,15,17,14" Spacing="12">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                                    <Border WidthRequest="36" HeightRequest="36" StrokeThickness="0" BackgroundColor="{Binding AccentColor}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="9" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Initial}" TextColor="White" FontFamily="Segoe UI Variable" FontSize="14" FontAttributes="Bold"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontFamily="Segoe UI Variable" FontSize="16" FontAttributes="Bold" />
                                        <Label Text="{Binding Description}" FontFamily="Segoe UI Variable" FontSize="11" TextColor="{AppThemeBinding Light=#747A85, Dark=#9A9FAB}" />
                                    </VerticalStackLayout>
                                    <Grid Grid.Column="2" ColumnDefinitions="Auto,Auto" ColumnSpacing="11">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="End">
                                            <Label Text="{Binding TotalTokensDisplay}" FontFamily="Segoe UI Variable" FontSize="21" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                            <Label Text="{Binding CostDisplay}" FontFamily="Segoe UI Variable" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="End"
                                                   TextColor="{AppThemeBinding Light=#574BD1, Dark=#B4ACFF}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light=#A6ABB5, Dark=#747982}"
                                               ToolTipProperties.Text="Przeciągnij, aby zmienić kolejność"
                                               SemanticProperties.Description="Przeciągnij, aby zmienić kolejność" />
                                    </Grid>
                                </Grid>

                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="WEJŚCIE" FontSize="8" FontAttributes="Bold" CharacterSpacing="0.8" TextColor="{AppThemeBinding Light=#9499A5, Dark=#777D8B}" />
                                        <Label Text="{Binding InputDisplay}" FontSize="14" FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="WYJŚCIE" FontSize="8" FontAttributes="Bold" CharacterSpacing="0.8" TextColor="{AppThemeBinding Light=#9499A5, Dark=#777D8B}" />
                                        <Label Text="{Binding OutputDisplay}" FontSize="14" FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="3">
                                        <Label Text="CACHE ZAPIS" FontSize="8" FontAttributes="Bold" CharacterSpacing="0.8" TextColor="{AppThemeBinding Light=#9499A5, Dark=#777D8B}" />
                                        <Label Text="{Binding CacheWriteDisplay}" FontSize="14" FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="3" Spacing="3">
                                        <Label Text="CACHE ODCZYT" FontSize="8" FontAttributes="Bold" CharacterSpacing="0.8" TextColor="{AppThemeBinding Light=#9499A5, Dark=#777D8B}" />
                                        <Label Text="{Binding CacheReadDisplay}" FontSize="14" FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <ProgressBar Progress="{Binding CacheShare}" ProgressColor="{Binding AccentColor}" HeightRequest="5" VerticalOptions="Center"
                                                 BackgroundColor="{AppThemeBinding Light=#EBEDF2, Dark=#2B2F3A}" />
                                    <Label Grid.Column="1" Text="{Binding CacheShareDisplay}" FontSize="9" TextColor="{AppThemeBinding Light=#8B909C, Dark=#707582}" />
                                </Grid>

                                <Button Text="{Binding DetailsToggleText}"
                                        Command="{Binding ToggleDetailsCommand}"
                                        FontFamily="Segoe UI Variable"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        Padding="6,0"
                                        Margin="-6,0,0,0"
                                        HeightRequest="30"
                                        MinimumHeightRequest="0"
                                        MinimumWidthRequest="0"
                                        HorizontalOptions="Start"
                                        CornerRadius="6"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light=#574BD1, Dark=#B4ACFF}" />

                                <Label Text="{Binding ModelsDisplay}" IsVisible="{Binding IsDetailsExpanded}" FontFamily="Segoe UI Variable" FontSize="11" LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light=#727986, Dark=#9BA0AD}" />

                                <Label Text="{Binding CreditsDisplay}" IsVisible="{Binding HasCredits}" FontSize="10" FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" TextColor="{AppThemeBinding Light=#4F3FD5, Dark=#A99FFF}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsDetailsExpanded}" Value="False">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Border IsVisible="{Binding IsDetailsExpanded}" Padding="11,9" StrokeThickness="0"
                                        BackgroundColor="{AppThemeBinding Light=#F0F1FF, Dark=#1E2032}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="11" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <Label Text="LIMIT 5H" FontSize="9" FontAttributes="Bold" CharacterSpacing="0.8" TextColor="{AppThemeBinding Light=#6861A4, Dark=#9D97DA}" />
                                            <ProgressBar Grid.Column="1" Progress="{Binding FiveHourProgress}" IsVisible="{Binding HasLimits}" ProgressColor="{Binding AccentColor}"
                                                         BackgroundColor="{AppThemeBinding Light=#DADCF0, Dark=#34364A}" VerticalOptions="Center" HeightRequest="5" />
                                            <Label Grid.Column="2" Text="{Binding FiveHourDisplay}" FontSize="11" FontAttributes="Bold" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding FiveHourReset}" FontSize="8" TextColor="{AppThemeBinding Light=#8B8EAA, Dark=#777C9D}" />
                                            <Label Grid.Column="1" Text="{Binding LimitStatus}" FontSize="8" TextColor="{AppThemeBinding Light=#8B8EAA, Dark=#777C9D}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <Label Text="LIMIT 7D" FontSize="9" FontAttributes="Bold" CharacterSpacing="0.8" TextColor="{AppThemeBinding Light=#6861A4, Dark=#9D97DA}" />
                                            <ProgressBar Grid.Column="1" Progress="{Binding SevenDayProgress}" IsVisible="{Binding HasLimits}" ProgressColor="{Binding AccentColor}"
                                                         BackgroundColor="{AppThemeBinding Light=#DADCF0, Dark=#34364A}" VerticalOptions="Center" HeightRequest="5" />
                                            <Label Grid.Column="2" Text="{Binding SevenDayDisplay}" FontSize="11" FontAttributes="Bold" />
                                        </Grid>
                                        <Label Text="{Binding SevenDayReset}" FontSize="8" TextColor="{AppThemeBinding Light=#8B8EAA, Dark=#777C9D}" />
                                    </VerticalStackLayout>
                                </Border>

                                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="7">
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Border WidthRequest="7" HeightRequest="7" BackgroundColor="#23C483" StrokeThickness="0" VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="4" />
                                            </Border.StrokeShape>
                                        </Border>
                                        <Label Text="{Binding ActiveSessions}" FontSize="12" FontAttributes="Bold" />
                                        <Label Text="aktywne" FontSize="10" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#7D8390, Dark=#969CA9}" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                        <Border WidthRequest="7" HeightRequest="7" BackgroundColor="{AppThemeBinding Light=#B5BAC5, Dark=#626877}" StrokeThickness="0" VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="4" />
                                            </Border.StrokeShape>
                                        </Border>
                                        <Label Text="{Binding CompletedSessions}" FontSize="12" FontAttributes="Bold" />
                                        <Label Text="zakończone" FontSize="10" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#7D8390, Dark=#969CA9}" />
                                    </HorizontalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding ActiveWindowDisplay}" FontSize="8" HorizontalTextAlignment="End" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#A0A5AF, Dark=#686E7C}" />
                                </Grid>

                                <Border IsVisible="{Binding IsDetailsExpanded}" Padding="10,8" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#20232D}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
                                            <Label Text="7d" FontSize="9" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#9A9FAB, Dark=#777D8B}" />
                                            <Label Grid.Column="1" Text="{Binding Last7Display}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="30d" FontSize="9" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#9A9FAB, Dark=#777D8B}" />
                                            <Label Grid.Column="3" Text="{Binding Last30Display}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                        </Grid>
                                        <Label Text="{Binding Status}" FontSize="9" MaxLines="1" LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light=#727986, Dark=#9BA0AD}" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <Button Text="{Binding UndetectedToggleText}"
                        Command="{Binding ToggleUndetectedCommand}"
                        FontFamily="Segoe UI Variable"
                        FontSize="11"
                        Margin="0,4,0,0"
                        MinimumHeightRequest="36"
                        HeightRequest="36"
                        CornerRadius="7"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light=#665E9C, Dark=#AAA3E4}" />
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentView>
