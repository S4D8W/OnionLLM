<?xml version="1.0" encoding="utf-8" ?>
<!-- Bloki 5-godzinne (DESIGN.md §6.5): active block card → KPI → blocks table with gaps → drawer. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:OnionLLM.Controls"
             xmlns:charts="clr-namespace:OnionLLM.Controls.Charts"
             xmlns:vm="clr-namespace:OnionLLM.ViewModels"
             xmlns:res="clr-namespace:OnionLLM.Resources"
             x:Class="OnionLLM.Views.BlocksView"
             x:DataType="vm:BlocksViewModel">
    <Grid RowDefinitions="Auto,Auto,*"
          Padding="{DynamicResource LayoutPagePadding}"
          RowSpacing="{StaticResource Space300}">
        <controls:PageHeader Title="Bloki 5-godzinne" Subtitle="Okna rozliczeniowe Claude odtworzone z historii">
            <controls:SplitButton x:Name="ExportButton" Text="Eksportuj" Command="{Binding ExportJsonCommand}" AutomationId="Blocks.Export" />
        </controls:PageHeader>

        <!-- Single filter: no FilterBar needed (a one-child FilterBar trips the XAML generator's collection content). -->
        <controls:SegmentedControl Grid.Row="1" ItemsSource="{Binding Ranges}" SelectedIndex="{Binding RangeIndex}" Label="Zakres" AutomationId="Blocks.Range" />

        <controls:EmptyState Grid.Row="2" IsVisible="{Binding ClaudeMissing}" Glyph="{x:Static res:Icons.Timer}"
                             Title="Bloki dotyczą tylko Claude Code" Description="Nie wykryto danych Claude Code na tym komputerze."
                             ActionText="Skonfiguruj Claude Code" ActionCommand="{Binding ConfigureCommand}" IsPrimaryAction="True" />

        <ScrollView x:Name="Body" Grid.Row="2" IsVisible="{Binding ClaudeMissing, Converter={StaticResource Invert}}">
            <VerticalStackLayout Spacing="{DynamicResource LayoutSectionGap}">
                <!-- Active block, extended (§6.5 pkt 2) -->
                <controls:Card Title="Aktywny blok" IsVisible="{Binding HasActive}" AutomationId="Blocks.Active">
                    <controls:Card.Actions>
                        <controls:StatusBadge Text="Aktywny" Kind="Live" />
                    </controls:Card.Actions>
                    <controls:Card.Body>
                        <VerticalStackLayout Spacing="{StaticResource Space300}">
                            <Label Style="{StaticResource Text.Caption.Secondary}" Text="{Binding ActiveRemaining}" />
                            <charts:BlockTimeline Cumulative="{Binding ActiveSeries}" Now="{Binding ActiveNow}"
                                                  Projection="{Binding ActiveProjection}" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space400}">
                                <controls:MetricLabel Value="{Binding ActiveCost}" Size="Md" Format="Cost" TextColor="{DynamicResource ColorDataCost}" />
                                <Label Grid.Column="1" Style="{StaticResource Text.Caption}" Text="{Binding ActiveTokens}" VerticalOptions="End" />
                            </Grid>
                            <controls:BurnRateBadge IsVisible="{Binding HasBurnRate}" CostPerHour="{Binding BurnCostPerHour}"
                                                    TokensPerMinute="{Binding BurnTokensPerMinute}" Level="{Binding BurnLevel}" />
                            <controls:LimitGauge IsVisible="{Binding HasLimit}" Title="{Binding LimitTitle}" Percent="{Binding ActiveLimitPercent}"
                                                 State="Estimated" ProjectionText="{Binding ProjectionText}" />
                            <Label Style="{StaticResource Text.Caption}" Text="{Binding ProjectionText}" IsVisible="{Binding HasLimit, Converter={StaticResource Invert}}" />
                        </VerticalStackLayout>
                    </controls:Card.Body>
                </controls:Card>
                <controls:Card Title="Brak aktywnego bloku" IsVisible="{Binding HasNoActive}">
                    <controls:Card.Body>
                        <Label Style="{StaticResource Text.Secondary}" Text="{Binding LastBlockText}" />
                    </controls:Card.Body>
                </controls:Card>

                <!-- KPI (§6.5 pkt 3) -->
                <Grid x:Name="KpiGrid" ColumnDefinitions="*,*,*,*" ColumnSpacing="{DynamicResource LayoutGridGap}" RowSpacing="{DynamicResource LayoutGridGap}">
                    <controls:StatTile Title="Bloki" Value="{Binding BlockCount}" Caption="{Binding RangeText}" />
                    <controls:StatTile Grid.Column="1" Title="Średnio / blok" Value="{Binding AverageCost}" />
                    <controls:StatTile Grid.Column="2" Title="Limit tokenów" Value="{Binding LimitValue}" Caption="{Binding LimitCaption}" />
                    <controls:StatTile Grid.Column="3" Title="Najdroższy blok" Value="{Binding MostExpensive}" Caption="{Binding MostExpensiveCaption}" />
                </Grid>

                <controls:DataTable x:Name="Table"
                                    ItemsSource="{Binding Blocks}"
                                    SelectedItem="{Binding SelectedBlock}"
                                    RowActivatedCommand="{Binding OpenDetailsCommand}"
                                    State="{Binding TableState}"
                                    HeightRequest="{StaticResource SizeTableHeight}"
                                    AutomationPrefix="Blocks">
                    <controls:DataTable.EmptyView>
                        <controls:EmptyState Variant="Inline" Title="Brak bloków w wybranym zakresie" Description="Wybierz dłuższy zakres." />
                    </controls:DataTable.EmptyView>
                </controls:DataTable>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>
