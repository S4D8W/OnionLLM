<?xml version="1.0" encoding="utf-8" ?>
<!-- Limity (DESIGN.md §6.2): one place for „ile mi zostało i kiedy reset?”. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:OnionLLM.Controls"
             xmlns:charts="clr-namespace:OnionLLM.Controls.Charts"
             xmlns:vm="clr-namespace:OnionLLM.ViewModels"
             xmlns:res="clr-namespace:OnionLLM.Resources"
             x:Class="OnionLLM.Views.LimitsView"
             x:DataType="vm:LimitsViewModel">
    <Grid RowDefinitions="Auto,Auto,*"
          Padding="{DynamicResource LayoutPagePadding}"
          RowSpacing="{StaticResource Space300}">
        <controls:PageHeader Title="Limity" Subtitle="{Binding Subtitle}">
            <Button Style="{StaticResource Button.Secondary.Sm}" Text="Odśwież limity" Command="{Binding RefreshLimitsCommand}" AutomationId="Limits.Refresh" />
        </controls:PageHeader>

        <controls:Banner Grid.Row="1" Kind="Info" IsVisible="{Binding ShowNoLimitsBanner}" Title="Limity Claude są niedostępne"
                         Message="Zaloguj się ponownie w Claude Code (claude /login), aby odczytać limity konta." />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="{DynamicResource LayoutSectionGap}">
                <controls:EmptyState IsVisible="{Binding HasClaude, Converter={StaticResource Invert}}" Glyph="{x:Static res:Icons.Gauge}"
                                     Title="Brak źródeł z limitami" Description="Limity konta są dziś dostępne tylko dla Claude Code, którego nie wykryto na tym komputerze." />

                <controls:Section Title="Claude" Description="Limity konta z API Anthropic i limit tokenów bloku liczony lokalnie" IsVisible="{Binding HasClaude}">
                    <controls:Section.Body>
                        <Grid x:Name="ClaudeGrid" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space800}" RowSpacing="{DynamicResource LayoutGridGap}">
                            <charts:OnionRings x:Name="Rings" Rings="{Binding Rings}"
                                               WidthRequest="{StaticResource SizeChartAux}" HeightRequest="{StaticResource SizeChartAux}"
                                               VerticalOptions="Start" AutomationId="Limits.Rings" />
                            <VerticalStackLayout x:Name="Gauges" Grid.Column="1" Spacing="{StaticResource Space600}">
                                <controls:LimitGauge Title="Limit 5-godzinny" Percent="{Binding FiveHour}" ResetText="{Binding FiveHourReset}"
                                                     ProjectionText="{Binding FiveHourForecast}"
                                                     State="{Binding LimitState}" LiveTooltip="{Binding LiveTooltip}" AutomationId="Limits.FiveHour" />
                                <controls:LimitGauge Title="Limit 7-dniowy" Percent="{Binding SevenDay}" ResetText="{Binding SevenDayReset}"
                                                     ProjectionText="{Binding SevenDayForecast}"
                                                     State="{Binding LimitState}" LiveTooltip="{Binding LiveTooltip}" AutomationId="Limits.SevenDay" />
                                <VerticalStackLayout Spacing="{StaticResource Space200}" IsVisible="{Binding HasActiveBlock}">
                                    <controls:LimitGauge Title="Aktywny blok" Percent="{Binding BlockPercent}" ResetText="{Binding BlockReset}"
                                                         ProjectionText="{Binding BlockProjection}" State="Estimated"
                                                         UnavailableText="Limit tokenów bloku nie jest ustawiony." AutomationId="Limits.Block" />
                                    <controls:BurnRateBadge IsVisible="{Binding HasBurnRate}" CostPerHour="{Binding BurnCostPerHour}"
                                                            TokensPerMinute="{Binding BurnTokensPerMinute}" Level="{Binding BurnLevel}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </controls:Section.Body>
                </controls:Section>

                <!-- §6.2 pkt 3: usage history from the recorded limit readings (7 days, thresholds 80/100%). -->
                <charts:ChartCard Title="Historia wykorzystania" Subtitle="Ostatnie 7 dni · odczyty co 5 min" IsVisible="{Binding HasClaude}" LegendStateKey="limits.history">
                    <charts:ChartCard.Chart>
                        <charts:LineChart Data="{Binding History}" AutomationId="Limits.History" />
                    </charts:ChartCard.Chart>
                </charts:ChartCard>

                <!-- §6.2 pkt 4: budgets (§5.9) computed locally from the logs. -->
                <controls:Section Title="Budżety" Description="Koszt z logów względem budżetów z Ustawień">
                    <controls:Section.Actions>
                        <Button Style="{StaticResource Button.Link}" Text="Zmień" Command="{Binding OpenBudgetSettingsCommand}" IsVisible="{Binding HasBudgets}" />
                    </controls:Section.Actions>
                    <controls:Section.Body>
                        <VerticalStackLayout Spacing="{StaticResource Space600}">
                            <controls:EmptyState Variant="Inline" IsVisible="{Binding HasNoBudgets}" Glyph="{x:Static res:Icons.Wallet}"
                                                 Title="Nie ustawiono budżetów" ActionText="Ustaw budżet" ActionCommand="{Binding OpenBudgetSettingsCommand}" />
                            <controls:LimitGauge Title="Budżet dzienny" Percent="{Binding DailyBudgetPercent}" ResetText="{Binding DailyBudgetText}"
                                                 State="Local" IsVisible="{Binding HasDailyBudget}" AutomationId="Limits.DailyBudget" />
                            <controls:LimitGauge Title="Budżet miesięczny" Percent="{Binding MonthlyBudgetPercent}" ResetText="{Binding MonthlyBudgetText}"
                                                 ProjectionText="{Binding MonthlyForecastText}" State="Local" IsVisible="{Binding HasMonthlyBudget}"
                                                 AutomationId="Limits.MonthlyBudget" />
                            <controls:DataTable x:Name="BudgetTable" ItemsSource="{Binding SourceBudgets}" IsVisible="{Binding HasSourceBudgets}"
                                                AutomationPrefix="Limits.Budgets" />
                        </VerticalStackLayout>
                    </controls:Section.Body>
                </controls:Section>

                <!-- §6.2 pkt 6: notification summary. -->
                <controls:Section Title="Powiadomienia">
                    <controls:Section.Actions>
                        <Button Style="{StaticResource Button.Link}" Text="Zmień" Command="{Binding OpenBudgetSettingsCommand}" />
                    </controls:Section.Actions>
                    <controls:Section.Body>
                        <Label Style="{StaticResource Text.Secondary}" Text="{Binding NotificationSummary}" AutomationId="Limits.Notifications" />
                    </controls:Section.Body>
                </controls:Section>

                <controls:Section Title="Inne narzędzia" Description="Brak danych o limitach dla tych narzędzi" IsCollapsible="True"
                                  StateKey="limits.others" IsVisible="{Binding HasOtherSources}">
                    <controls:Section.Body>
                        <VerticalStackLayout x:Name="OthersList" BindableLayout.ItemsSource="{Binding OtherSources}" />
                    </controls:Section.Body>
                </controls:Section>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>
