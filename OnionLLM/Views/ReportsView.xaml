<?xml version="1.0" encoding="utf-8" ?>
<!--
    Raporty (DESIGN.md §6.3): PageHeader (range, Eksportuj) → FilterBar → KPI ×4 → „W czasie” → „Udział” + „Aktywność”
    → table of periods (expandable breakdown, „Razem”, drawer) → PricingNote.
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:OnionLLM.Controls"
             xmlns:charts="clr-namespace:OnionLLM.Controls.Charts"
             xmlns:vm="clr-namespace:OnionLLM.ViewModels"
             x:Class="OnionLLM.Views.ReportsView"
             x:DataType="vm:ReportsViewModel">
    <Grid RowDefinitions="Auto,Auto,*"
          Padding="{DynamicResource LayoutPagePadding}"
          RowSpacing="{StaticResource Space300}">
        <controls:PageHeader Title="Raporty" Subtitle="{Binding RangeText}">
            <controls:SplitButton x:Name="ExportButton" Text="Eksportuj" Command="{Binding ExportCsvCommand}" AutomationId="Reports.Export" />
        </controls:PageHeader>

        <controls:FilterBar Grid.Row="1" IsDirty="{Binding IsFiltered}" ResetCommand="{Binding ResetFiltersCommand}">
            <controls:SegmentedControl ItemsSource="{Binding Periods}" SelectedIndex="{Binding PeriodIndex}" Label="Okres" />
            <controls:DateRangePicker Presets="{Binding Presets}" PresetIndex="{Binding RangeIndex}" CustomIndex="{Binding CustomPresetIndex}"
                                      Since="{Binding Since}" Until="{Binding Until}" DisplayText="{Binding RangeText}" AutomationId="Reports.Range" />
            <controls:FilterChip Variant="Menu" Label="Źródło" ItemsSource="{Binding SourceChoiceNames}" SelectedIndex="{Binding SourceIndex}" AutomationId="Reports.Source" />
            <controls:FilterChip Label="Modele" IsChecked="{Binding Breakdown}" AutomationId="Reports.SplitModels" />
            <controls:FilterChip Label="Źródła" IsChecked="{Binding BySource}" IsVisible="{Binding CanSplitBySource}" AutomationId="Reports.SplitSources" />
            <controls:FilterChip Label="Projekty" IsChecked="{Binding GroupByProject}" AutomationId="Reports.SplitProjects" />
        </controls:FilterBar>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="{DynamicResource LayoutSectionGap}">
                <Grid x:Name="KpiGrid" ColumnDefinitions="*,*,*,*" ColumnSpacing="{DynamicResource LayoutGridGap}" RowSpacing="{DynamicResource LayoutGridGap}">
                    <controls:StatTile Title="Koszt łącznie" Value="{Binding TotalCost}" Marker="{Binding TotalMarker}" Caption="{Binding StoredCaption}" AutomationId="Reports.Kpi.Cost" />
                    <controls:StatTile Grid.Column="1" Title="Tokeny" Value="{Binding TotalTokens}" Caption="{Binding TotalTokensCaption}" AutomationId="Reports.Kpi.Tokens" />
                    <controls:StatTile Grid.Column="2" Title="{Binding AverageTitle}" Value="{Binding AverageCost}" AutomationId="Reports.Kpi.Average" />
                    <controls:StatTile Grid.Column="3" Title="Udział cache" Value="{Binding CacheShare}" AutomationId="Reports.Kpi.Cache" />
                </Grid>

                <charts:ChartCard x:Name="TimeCard" Title="W czasie" Subtitle="{Binding RangeText}" LegendStateKey="reports.time">
                    <charts:ChartCard.Controls>
                        <controls:SegmentedControl ItemsSource="{Binding Metrics}" SelectedIndex="{Binding MetricIndex}" IsSmall="True" Label="Metryka" />
                    </charts:ChartCard.Controls>
                    <charts:ChartCard.Chart>
                        <charts:BarChart x:Name="TimeChart" Data="{Binding Chart}" AutomationId="Reports.Chart" />
                    </charts:ChartCard.Chart>
                </charts:ChartCard>

                <Grid x:Name="AnalysisGrid" ColumnDefinitions="*,*" ColumnSpacing="{DynamicResource LayoutGridGap}" RowSpacing="{DynamicResource LayoutGridGap}">
                    <charts:ChartCard x:Name="ShareCard" Title="Udział" Subtitle="Koszt">
                        <charts:ChartCard.Controls>
                            <controls:SegmentedControl ItemsSource="{Binding ShareModes}" SelectedIndex="{Binding ShareIndex}" IsSmall="True" Label="Udział" />
                        </charts:ChartCard.Controls>
                        <charts:ChartCard.Chart>
                            <charts:DonutChart Data="{Binding Share}" CenterLabel="{Binding ShareCenterLabel}" />
                        </charts:ChartCard.Chart>
                    </charts:ChartCard>
                    <controls:Card x:Name="ActivityCard" Grid.Column="1" Title="Aktywność" Subtitle="Koszt dzienny · ostatnie 12 miesięcy">
                        <controls:Card.Body>
                            <ScrollView Orientation="Horizontal">
                                <charts:Heatmap Days="{Binding Activity}" />
                            </ScrollView>
                        </controls:Card.Body>
                    </controls:Card>
                </Grid>

                <controls:DataTable x:Name="Table"
                                    ItemsSource="{Binding Rows}"
                                    SortKey="{Binding SortKey}"
                                    SortDescending="{Binding SortDescending}"
                                    SelectedItem="{Binding SelectedRow}"
                                    RowActivatedCommand="{Binding OpenDetailsCommand}"
                                    State="{Binding TableState}"
                                    TotalRow="{Binding TotalRow}"
                                    HeightRequest="{StaticResource SizeTableHeight}"
                                    AutomationPrefix="Reports">
                    <controls:DataTable.EmptyView>
                        <controls:EmptyState Variant="Inline" Title="Brak danych w tym zakresie" Description="Zmień zakres lub źródło."
                                             ActionText="Pokaż całą historię" ActionCommand="{Binding ShowAllCommand}" />
                    </controls:DataTable.EmptyView>
                </controls:DataTable>

                <controls:PricingNote Text="{Binding PricingNote}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>
