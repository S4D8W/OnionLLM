<Shell
    x:Class="OnionLLM.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:OnionLLM"
    xmlns:pages="clr-namespace:OnionLLM.Pages"
    Title="OnionLLM"
    FlyoutBehavior="Flyout"
    FlyoutWidth="260"
    FlyoutBackgroundColor="{AppThemeBinding Light=#F7F8FC, Dark=#151821}"
    Shell.NavBarIsVisible="False">

    <Shell.FlyoutHeader>
        <Grid Padding="22,28,18,22" ColumnDefinitions="44,*" ColumnSpacing="12">
            <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" BackgroundColor="#5B4BFF">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Label Text="O" FontSize="22" FontAttributes="Bold" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="OnionLLM" FontSize="17" FontAttributes="Bold" />
                <Label Text="Token &amp; cost monitor" FontSize="10"
                       TextColor="{AppThemeBinding Light=#737A89, Dark=#9BA2B2}" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <ShellContent Title="Dziś" ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
    <ShellContent Title="Raporty" ContentTemplate="{DataTemplate pages:ReportsPage}" Route="Reports" />
    <ShellContent Title="Sesje" ContentTemplate="{DataTemplate pages:SessionsPage}" Route="Sessions" />
    <ShellContent Title="Bloki" ContentTemplate="{DataTemplate pages:BlocksPage}" Route="Blocks" />
    <ShellContent Title="Ustawienia" ContentTemplate="{DataTemplate pages:SettingsPage}" Route="Settings" />

</Shell>
