<Application xmlns:styles="clr-namespace:OnionLLM.Resources.Styles"
             xmlns:converters="clr-namespace:OnionLLM.Converters"
             x:Class="OnionLLM.App">
    <Application.Resources>
        <ResourceDictionary>
            <!--
                Order matters (DESIGN.md §3.2): ThemeService and DensityService replace the entries at the indices
                declared in DesignResources (2 = theme, 3 = source colours, 4 = density). Styles come last.
            -->
            <ResourceDictionary.MergedDictionaries>
                <styles:TokensPrimitives />
                <styles:TokensStatic />
                <styles:TokensLight />
                <styles:TokensSourcesLight />
                <styles:TokensComfortable />
                <ResourceDictionary Source="Resources/Styles/Styles.Text.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.Controls.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.Surfaces.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.Implicit.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:TokenColorConverter x:Key="TokenColor" />
            <converters:InvertBoolConverter x:Key="Invert" />
            <converters:EqualsConverter x:Key="Equals" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
