<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OnionLLM.Core</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Pricing\pricing-snapshot.json" LogicalName="OnionLLM.Core.pricing-snapshot.json" />
    <EmbeddedResource Include="Pricing\models-dev-snapshot.json" LogicalName="OnionLLM.Core.models-dev-snapshot.json" />
    <EmbeddedResource Include="Pricing\models-dev-catalog-rules.json" LogicalName="OnionLLM.Core.models-dev-catalog-rules.json" />
    <EmbeddedResource Include="Config\onionllm.schema.json" LogicalName="OnionLLM.Core.onionllm.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OnionLLM.Core.Tests" />
  </ItemGroup>

</Project>
